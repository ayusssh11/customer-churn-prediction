# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Local data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated model artifacts
models/*
!models/.gitkeep

# macOS
.DS_Store

# Editor settings
.vscode/
.idea/
EOF

.venv/
data/raw/
__pycache__/
.pytest_cache/
.ruff_cache/

models/*.joblib